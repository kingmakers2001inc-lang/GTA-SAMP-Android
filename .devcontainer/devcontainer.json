{
	"name": "Grand RP server",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
	"remoteUser": "vscode",
	// Starts the server (and the playit.gg tunnel once its key is saved) every time the codespace starts
	"postStartCommand": "bash server/deploy/codespace.sh > /tmp/grand-rp-start.log 2>&1 || true"
}
